  "query": "\n        SELECT\n            r.global_rank, r.regional_rank, m.uid, m.region, m.name, m.level, m.signature, m.avatar_icon, m.achievement_count, m.updated_at\n        FROM\n            achievement_ranks r\n        JOIN\n            mihomo m ON m.uid = r.uid\n        WHERE\n            r.uid = $1\n        ",
